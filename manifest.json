{
  "manifest_version": 3,
  "name": "Fashionphile Scan Bar Code",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {},
  "content_scripts": [
    {
      "matches": [
        "https://*.fashionphile.com/scanner/*",
        "https://*.fashionphile.com/receiving/index/*",
        "https://*.fashionphile.us/scanner/*",
        "https://*.fashionphile.us/receiving/index/*",
        "https://*.fashionphile.dev/scanner/*",
        "https://*.fashionphile.dev/receiving/index/*",
        "http://*.fashionphile.test/scanner/*",
        "http://*.fashionphile.test/receiving/index/*",
        "http://localhost/scanner/*",
        "http://localhost/products/receiving/index/*"
      ],
      "js": [
        "injector.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
